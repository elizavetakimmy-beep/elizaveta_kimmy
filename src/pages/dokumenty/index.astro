---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, legalDocs } from '../../site';

/* Одна страница со всеми юридическими документами.
   Нужна для ботов и форм: там помещается только одна ссылка. */
const docs = await getCollection('docs');
const updatedById = new Map(docs.map((entry) => [entry.id, entry.data.updated]));

const items = legalDocs.map((doc) => {
  const slug = doc.href.split('/').filter(Boolean).pop();
  return { ...doc, updated: slug ? updatedById.get(slug) : undefined };
});
---

<Base
  title="Документы"
  description="Оферта, политика обработки персональных данных и согласия."
  variant="reading"
>
  <article class="doc">
    <header class="shell doc__head">
      <p class="kicker">документы</p>
      <h1 class="doc__title">Оферта, политика и согласия</h1>
      <p class="doc__lead">
        Здесь лежат все документы, на которые я ссылаюсь в боте, в форме заявки и на страницах
        с оплатой. Каждый открывается полностью, скачивать ничего не нужно.
      </p>
    </header>

    <div class="shell">
      <ul class="doc__list">
        {items.map((item) => (
          <li>
            <a href={item.href}>
              <span class="doc__label">{item.label}</span>
              {item.updated && <span class="doc__date">редакция от {formatDate(item.updated)}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </article>
</Base>

<style>
  .doc__head { padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem); }

  .doc__title {
    margin-top: 0.75rem;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    max-width: 24ch;
  }

  .doc__lead {
    margin-top: 1.25rem;
    max-width: 46rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text);
  }

  .doc__list {
    max-width: 46rem;
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .doc__list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-mute);
  }

  .doc__list a:hover { color: var(--ink); }
  .doc__list li:first-child a { border-top: 1px solid var(--rule); }

  .doc__label { font-size: 1.05rem; }

  .doc__date {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }
</style>
