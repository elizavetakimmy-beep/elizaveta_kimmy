---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, readingTime, site } from '../../site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, lead, date, topic } = entry.data;
---

<Base title={title} description={lead} variant="reading">
  <article class="piece">
    <header class="shell piece__head">
      <p class="piece__meta">
        <span class="sticker">{topic}</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(entry.body ?? '')}</span>
      </p>

      <h1 class="piece__title">{title}</h1>
      <p class="piece__lead">{lead}</p>
    </header>

    <div class="shell">
      <div class="prose">
        <Content />
      </div>

      <footer class="tail">
        <p class="tail__line">
          Пишу ещё в Телеграме — там разборы подробнее и промпты, которые можно скопировать.
        </p>
        <div class="tail__actions">
          <a class="btn" href={site.links.telegram}>Телеграм-канал</a>
          <a class="btn btn--ghost" href="/blog/">Другие статьи</a>
        </div>
      </footer>
    </div>
  </article>
</Base>

<style>
  .piece__head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.75rem, 4vw, 2.75rem);
  }

  .piece__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-mute);
    margin-bottom: 1.1rem;
  }

  .piece__title {
    font-size: clamp(2rem, 1.3rem + 3.2vw, 3.5rem);
    max-width: 20ch;
  }

  .piece__lead {
    margin-top: 1.2rem;
    max-width: var(--measure);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.1875rem);
    color: var(--ink-mute);
  }

  /* Текст статьи: узкая колонка, крупный кегль, спокойный ритм */
  .prose {
    max-width: var(--measure);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem);
    line-height: 1.7;
    color: var(--text);
  }

  .prose :global(> * + *) { margin-top: 1.35em; }

  .prose :global(h2) {
    margin-top: 2.4em;
    font-size: 1.5em;
    line-height: 1.2;
    color: var(--ink);
  }

  .prose :global(h3) { margin-top: 2em; font-size: 1.18em; color: var(--ink); }

  .prose :global(strong) { color: var(--ink); }

  .prose :global(a) {
    color: var(--ink);
    border-bottom: 1px solid var(--acc);
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.2em;
    border-left: 2px solid var(--acc);
    font-size: 1.15em;
    line-height: 1.4;
    font-weight: 500;
    color: var(--ink);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
    list-style: revert;
  }

  .prose :global(li + li) { margin-top: 0.5em; }
  .prose :global(li::marker) { color: var(--acc); }

  .prose :global(pre) {
    padding: 1rem 1.2rem;
    border-radius: 0.9rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    font-size: 0.85em;
    overflow-x: auto;
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.4em;
    border-radius: 0.3em;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
  }

  .prose :global(img) {
    border-radius: 0.9rem;
    border: 1px solid var(--rule);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9em;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.6em 0.8em;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .tail {
    margin-top: clamp(3rem, 8vw, 5rem);
    max-width: var(--measure);
    padding: 1.75rem;
    border-radius: 1.1rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
  }

  .tail__line { font-size: 1.05rem; color: var(--ink); }

  .tail__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
