---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, readingTime, site } from '../../site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, lead, date, topic } = entry.data;
---

<Base title={title} description={lead} variant="reading">
  <article class="piece">
    <header class="shell piece__head">
      <p class="piece__meta">
        <span class="sticker">{topic}</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(entry.body ?? '')}</span>
      </p>

      <h1 class="piece__title">{title}</h1>
      <p class="piece__lead">{lead}</p>
    </header>

    <div class="shell">
      <div class="prose">
        <Content />
      </div>

      <footer class="tail">
        <p class="tail__line">
          Пишу ещё в Телеграме — там разборы подробнее и
          промпты, которые можно скопировать.
        </p>
        <div class="tail__actions">
          <a class="btn btn--solid" href={site.links.telegram}>Телеграм-канал</a>
          <a class="btn btn--ghost" href="/blog/">Другие статьи</a>
        </div>
      </footer>
    </div>
  </article>
</Base>

<style>
  .piece__head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.75rem, 4vw, 2.75rem);
  }

  .piece__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--ink-mute);
    margin-bottom: 1.1rem;
  }

  .piece__title {
    font-size: clamp(2rem, 1.3rem + 3.2vw, 3.5rem);
    max-width: 20ch;
  }

  .piece__lead {
    margin-top: 1.2rem;
    max-width: var(--measure);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.1875rem);
    color: var(--ink-mute);
  }

  /* Текст статьи: узкая колонка, крупный кегль, спокойный ритм */
  .prose {
    max-width: var(--measure);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem);
    line-height: 1.7;
  }

  .prose :global(> * + *) {
    margin-top: 1.35em;
  }

  .prose :global(h2) {
    margin-top: 2.4em;
    font-size: 1.5em;
    line-height: 1.2;
  }

  .prose :global(h3) {
    margin-top: 2em;
    font-size: 1.18em;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.2em;
    border-left: 1px solid var(--rule-strong);
    font-size: 1.2em;
    line-height: 1.4;
    font-weight: 500;
    color: var(--ink);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
  }

  .prose :global(li + li) {
    margin-top: 0.5em;
  }

  .prose :global(li::marker) {
    color: var(--mark);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(a) {
    text-decoration-color: var(--mark);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin-block: 2.5em;
  }

  .prose :global(code) {
    font-size: 0.88em;
    padding: 0.15em 0.35em;
    background: var(--paper-raised);
    border-radius: 2px;
  }

  .prose :global(pre) {
    padding: 1.1em 1.25em;
    overflow-x: auto;
    background: var(--paper-raised);
    border-radius: 2px;
    font-size: 0.875em;
    line-height: 1.55;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(img) {
    border-radius: 2px;
  }

  .prose :global(figcaption) {
    margin-top: 0.6em;
    font-size: 0.8125rem;
    color: var(--ink-mute);
  }

  .tail {
    margin-top: clamp(3rem, 8vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .tail__line {
    font-size: 1.125rem;
  }

  .tail__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
