---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { readingTime } from '../../site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base
  title="Статьи"
  description="Инструкции и разборы: как настроить нейронку под себя, где она помогает в работе с клиентами, а где приходится править руками."
>
  <section class="sec head">
    <div class="glow" style="left:-10rem;top:-12rem;width:36rem;height:28rem"></div>
    <div class="shell" style="position:relative">
      <p class="kicker">разборы · промпты · приёмы</p>
      <h1 class="h2 silver" style="margin-top:.75rem">Статьи</h1>
      <p class="lead">
        Разборы, эксперименты и рабочие приёмы. Всё, что здесь написано, я сначала пробовала на
        своём блоге.
      </p>
    </div>
  </section>

  <section class="shell">
    {
      articles.length > 0 ? (
        <div class="feed">
          {articles.map((entry) => (
            <ArticleCard
              href={`/blog/${entry.id}/`}
              title={entry.data.title}
              lead={entry.data.lead}
              date={entry.data.date}
              topic={entry.data.topic}
              minutes={readingTime(entry.body ?? '')}
            />
          ))}
        </div>
      ) : (
        <p class="empty">Пока пусто. Первая статья скоро появится.</p>
      )
    }
  </section>
</Base>

<style>
  .head { padding-bottom: clamp(1.5rem, 4vw, 2.5rem); }

  .feed {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .empty { color: var(--ink-mute); }
</style>
