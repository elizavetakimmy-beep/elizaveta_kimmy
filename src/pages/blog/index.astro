---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { readingTime } from '../../site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base
  title="Статьи"
  description="Статьи о продвижении в блоге, нейросетях для экспертов и работе без выгорания."
>
  <section class="shell head">
    <h1 class="head__title">Статьи</h1>
    <p class="head__lead">
      Разборы, эксперименты и рабочие приёмы. Всё, что здесь написано, я сначала
      пробовала <span class="marker">на своём блоге</span>.
    </p>
  </section>

  <section class="shell">
    {
      articles.length > 0 ? (
        <div class="feed">
          {articles.map((entry) => (
            <ArticleCard
              href={`/blog/${entry.id}/`}
              title={entry.data.title}
              lead={entry.data.lead}
              date={entry.data.date}
              topic={entry.data.topic}
              minutes={readingTime(entry.body ?? '')}
            />
          ))}
        </div>
      ) : (
        <p class="empty">Пока пусто. Первая статья скоро появится.</p>
      )
    }
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .head__title {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4rem);
  }

  .head__lead {
    margin-top: 1.1rem;
    max-width: var(--measure);
    font-size: 1.0625rem;
    color: var(--ink-mute);
  }

  .feed {
    border-bottom: 1px solid var(--rule);
  }

  .empty {
    color: var(--ink-mute);
  }
</style>
