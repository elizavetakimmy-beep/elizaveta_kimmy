---
import Base from '../layouts/Base.astro';
import Marker from '../components/Marker.astro';
import { site } from '../site';

/* TODO (Лиза): статус набора и число занятых мест сверять перед каждой правкой.
   Устаревшую цифру эта аудитория проверит и запомнит. */
const parts = [
  {
    title: 'Уроки в записи',
    text: 'Доступ, оплата, установка — в том числе на Mac, — VPN и база работы с нейронкой. До пятнадцати минут, смотришь с телефона в своём темпе. Остаются у тебя насовсем.',
  },
  {
    title: 'Личный разговор с каждой',
    text: 'Я сажусь с тобой и разбираю, что у тебя за задачи и что из них реально можно ускорить. С тобой, а не с абстрактным специалистом.',
  },
  {
    title: 'Промпты под твои задачи',
    text: 'Проверенная база — вся твоя. Плюс после разговора короткий список под твой проект, твои задачи и твой голос.',
  },
  {
    title: 'Я в личке всё время интенсива',
    text: 'Написала — я ответила. Нас не больше десяти, иначе личная работа перестаёт быть личной.',
  },
];

const forWhom = [
  'Ведёшь блог сама и пишешь тексты руками',
  'Пробовала нейронки урывками: начала и бросила',
  'Клиенты съедают всё время, на своё не остаётся',
  'Уже покупала подборку промптов, и она лежит',
];

const notFor = [
  'Хочешь, чтобы контент делался без твоего участия',
  'Нет двадцати минут в день ближайшие две недели',
  'Нужны интеграции, боты и техническая настройка',
  'Ждёшь роста продаж к конкретной дате',
];
---

<Base
  title="Интенсив по нейросетям"
  description="Интенсив по нейросетям для тех, кто продаёт свои знания и услуги. Уроки в записи, личный разбор твоих задач и промпты под них."
>
  <section class="shell head">
    <p class="eyebrow">18 августа — 4 сентября · первый поток</p>
    <h1 class="head__title">Интенсив <Marker>по нейросетям</Marker></h1>
    <p class="head__lead">
      Для тех, кто открыл нейронку, попросил «напиши пост», получил гладкий
      текст про «в современном мире» — и закрыл. Ты не ошиблась в выводе. Ты
      ошиблась в эксперименте.
    </p>
    <div class="head__actions">
      <a class="btn btn--solid" href={site.links.telegram}>Спросить про интенсив</a>
    </div>
  </section>

  <section class="shell block">
    <h2 class="block__title">Как устроено</h2>
    <div class="parts">
      {
        parts.map((part) => (
          <div class="paper part">
            <h3>{part.title}</h3>
            <p>{part.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell block">
    <div class="money">
      <div>
        <p class="money__num">4 900 ₽</p>
        <p class="money__note">Такая цена, потому что поток первый.</p>
      </div>
      <div class="money__honest">
        <p class="eyebrow">честно про вход</p>
        <p>
          Сама нейросеть — отдельные деньги. Клод — 2 000–3 000 ₽ в месяц, чат
          GPT — около 900 ₽, VPN — рублей 300. Если ты не в маркетинге, тебе
          хватит варианта за 900. Где брать, как оплатить и что делать, если
          карта не работает, разберём в первый же день. Это та стена, о которую
          большинство разбилось и решило, что нейронки не работают.
        </p>
      </div>
    </div>
  </section>

  <section class="shell block">
    <div class="split">
      <div>
        <h2 class="block__title">Кому подойдёт</h2>
        <ul class="list">
          {forWhom.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="paper">
        <p class="eyebrow">кому точно не надо</p>
        <ul class="list list--no">
          {notFor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="shell block">
    <h2 class="block__title">Почему даты такие</h2>
    <p class="dates">
      6 сентября я уезжаю в отпуск, поэтому поток один и он сейчас. Заканчиваем
      4-го — в сентябрь ты входишь с настроенной системой. Как проходит твой
      сентябрь обычно, ты помнишь.
    </p>
  </section>

  <section class="shell">
    <aside class="cta">
      <p class="cta__line">
        Напиши мне в Телеграм — расскажу подробнее и отвечу на вопросы до
        оплаты. Отвечаю я сама.
      </p>
      <a class="btn btn--solid" href={site.links.telegram}>Написать</a>
    </aside>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem); }

  .head__title {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 1.3rem + 4.2vw, 4.25rem);
    max-width: 14ch;
  }

  .head__lead {
    margin-top: 1.5rem;
    max-width: var(--measure);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.1875rem);
    color: var(--ink-mute);
  }

  .head__actions { margin-top: 2rem; }

  .block { margin-top: clamp(3rem, 8vw, 5rem); }

  .block__title { font-size: clamp(1.5rem, 1.25rem + 1.2vw, 2.125rem); }

  .parts {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-top: 2rem;
  }

  .part h3 { font-size: 1.0625rem; letter-spacing: -0.02em; }

  .part p {
    margin-top: 0.8rem;
    font-size: 0.9375rem;
    color: var(--ink-mute);
  }

  .money {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 52rem) {
    .money { grid-template-columns: 14rem minmax(0, 1fr); }
  }

  .money__num {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    letter-spacing: -0.03em;
  }

  .money__note {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    color: var(--ink-mute);
  }

  .money__honest p:last-child {
    margin-top: 0.8rem;
    max-width: var(--measure);
    font-size: 0.9375rem;
    color: var(--ink-mute);
  }

  .split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    align-items: start;
  }

  .list {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
    max-width: 34ch;
  }

  .list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9375rem;
    color: var(--ink-mute);
  }

  .list li::before {
    content: '·';
    position: absolute;
    left: 0.3rem;
    color: var(--ink);
    font-weight: 700;
  }

  .list--no li::before {
    content: '×';
    left: 0.2rem;
    color: var(--pen);
    font-weight: 600;
  }

  .dates {
    margin-top: 1.2rem;
    max-width: var(--measure);
    color: var(--ink-mute);
  }

  .cta {
    margin-top: clamp(3.5rem, 9vw, 5.5rem);
    padding: clamp(2rem, 5vw, 3rem);
    background: var(--ink);
    color: var(--paper);
  }

  .cta__line {
    max-width: 34ch;
    margin-bottom: 1.5rem;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    line-height: 1.4;
  }

  .cta .btn--solid {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  .cta .btn--solid:hover { background: #fff; color: #000; }
</style>
