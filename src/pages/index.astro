---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site, readingTime } from '../site';

/* Тексты — «Личный блог/тексты_главная_04.09.md»: витрина линейки,
   два пути «Сами» и «Со мной» по продуктовой матрице и созвону 3.09. */

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const self = [
  {
    n: '01',
    title: 'Телеграм-канал, бесплатно',
    text: 'Промпты, которые копируются одним тапом, разборы и мои цифры, включая недели, где ничего не выросло. Кодовые слова из рилсов ведут сюда.',
    link: { href: site.links.telegram, label: 'Подписаться' },
  },
  {
    n: '02',
    title: 'Интенсив в записи, 2 900 ₽',
    text: 'Восемь уроков до пятнадцати минут: ставите Клод, настраиваете под себя и делаете карусели, сценарии и монтаж рилсов сами. Доступ два месяца. За 4 900 ₽ добавляются три недели чата со мной.',
    link: { href: '/intensive/', label: 'Программа и тарифы' },
    hot: true,
  },
  {
    n: '03',
    title: 'Клуб для тех, кто прошёл интенсив',
    text: 'Позже. Пока не запускаю. Семь человек первого потока уже внутри.',
  },
];

const withMe = [
  {
    n: '01',
    title: 'Две консультации, 10 000 ₽',
    text: 'Для тех, кто уже работает в Клоде. На первом созвоне разбираем ваши задачи. Между созвонами я собираю под них промпты и скиллы. На втором показываю, куда что закидывать. Потом можно писать с вопросами.',
  },
  {
    n: '02',
    title: 'Упаковка, полтора месяца, 40 000 ₽',
    text: 'Разбираем блог целиком: закрепы, сторис, сайт, мини-продукт и воронка к нему. Я говорю, что делать, вы делаете. Три места по этой цене, дальше дороже.',
  },
  {
    n: '03',
    title: 'Сопровождение, помесячно',
    text: 'Я ваш маркетолог, вы про это больше не думаете. Начинается после упаковки, цену обсуждаем лично.',
  },
];

const claudeDoes = [
  ['Сценарии рилс', true], ['Карусели', true], ['Монтаж рилса', true], ['Разбор конкурентов', true],
  ['Расшифровка созвонов', true], ['Разбор аудитории', true], ['Банк тем', true],
  ['Стратегия', false], ['Смыслы и оффер', false], ['Созвоны с клиентом', false], ['Решение, что делать', false], ['Съёмка', false],
] as const;

const faq = [
  {
    q: 'Интенсив, консультации или упаковка, что брать мне',
    a: 'Если ещё не ставили Клод и ведёте блог сами, интенсив. Если уже работаете в Клоде и упёрлись в то, что половина задач всё ещё руками, консультации. Если времени на своё нет вообще, упаковка. Если сомневаетесь, напишите, разберём в переписке.',
  },
  {
    q: 'Если через нейронку, за что мне тогда платят клиенты',
    a: 'Нейросеть не знает, что сказать. Знаете вы. Кто не разбирается в теме, получит из неё мусор и не заметит. Вы получите рабочий материал, потому что вам есть чем его оценить.',
  },
  {
    q: 'Я не технарь, я не разберусь',
    a: 'И не надо им становиться. Ни в интенсиве, ни в работе со мной нет инструкций про интеграции и ботов. Открыть, потыкать, посмотреть, что вышло. Я сама начинала с того, что выходило странно и мне не нравилось.',
  },
];
---

<Base hero>
  <!-- 1. Первый экран -->
  <Hero buttonLabel="Телеграм-канал" buttonHref={site.links.telegram}>
    <b>Вы попросили и закрыли вкладку.</b> Я маркетолог, работаю с нейронками каждый день. Показываю, что происходит между этим запросом и рабочим текстом.
  </Hero>

  <!-- 2. Переворот -->
  <section class="sec sec--light">
    <div class="sphere" style="width:16rem;height:16rem;right:-5rem;top:1rem;opacity:.9"></div>
    <div class="shell">
      <h2 class="h2 rv">Безликий текст получается<br />из безликого запроса</h2>
      <p class="lead rv">
        Нейросеть не знает вашего голоса, потому что его ей никто не показал. И не знает вашего
        проекта, ваших клиентов, ваших задач, по той же причине.
      </p>

      <div class="compare">
        <div class="paper rv">
          <p class="kicker">так просят обычно</p>
          <p class="prompt"><span class="dim">&gt;</span> напиши пост про выгорание</p>
          <p class="out out--dead">
            В современном мире выгорание становится всё более актуальной проблемой. Многие
            специалисты сталкиваются с…
          </p>
        </div>
        <div class="paper paper--light paper--tilt rv">
          <p class="kicker">так прошу я</p>
          <p class="prompt">
            <span class="dim">&gt;</span> вот три моих поста, вот как я шучу, вот слова, которые я
            никогда не пишу. Тема: выгорание
          </p>
          <p class="out">
            Я не выгорела. Я просто перестала успевать делать для себя то, что делаю для
            клиентов…
          </p>
        </div>
      </div>

      <p class="thesis rv">
        Она не заменит человека. Она сделает вашу работу проще, легче и интереснее. Нейросеть не
        знает, что сказать. <span class="serif-i">Знаете вы.</span> Она быстро печатает.
      </p>
      <p class="big rv">
        Я маркетолог, который довёл свою работу до системы на нейронках и ставит такую же клиенту.
      </p>
    </div>
  </section>

  <!-- 3. Как со мной работать -->
  <section class="sec" id="work">
    <div class="glow" style="left:-12rem;top:-10rem;width:40rem;height:32rem"></div>
    <div class="shell">
      <p class="kicker rv">два пути · сами или со мной</p>
      <h2 class="h2 rv" style="margin-top:.75rem">Как со мной <span class="violet">работать</span></h2>
      <p class="lead rv">
        Одним нужно уметь самим, другим нужен маркетолог. Это разные люди, поэтому пути два. Куда бы
        вы ни пошли, нейросети внутри одни и те же: те, на которых работаю я.
      </p>

      <div class="paths">
        <div class="path">
          <h3 class="path__title rv">Сами <span>ведёте блог сами и хотите уметь</span></h3>
          {self.map((s) => (
            <div class={`step rv${s.hot ? ' step--hot' : ''}`}>
              <span class="mono num">{s.n}</span>
              <div>
                <h4>{s.title}</h4>
                <p>{s.text}</p>
                {s.link && <a class="more" href={s.link.href}>{s.link.label} →</a>}
              </div>
            </div>
          ))}
        </div>
        <div class="path">
          <h3 class="path__title rv">Со мной <span>времени на своё нет, нужен маркетолог</span></h3>
          {withMe.map((s) => (
            <div class="step rv">
              <span class="mono num">{s.n}</span>
              <div>
                <h4>{s.title}</h4>
                <p>{s.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="actions rv">
        <a class="btn" href={site.links.telegramPersonal}>Написать в Телеграм</a>
        <p class="note">Если непонятно, с чего начать, напишите.</p>
      </div>

      <p class="kicker rv" style="margin:3rem 0 1rem">что в моей работе делает Клод · подсвечено то, что отдала ему, серое делаю руками</p>
      <div class="chips rv">
        {claudeDoes.map(([t, on]) => <span class={`chip${on ? ' chip--on' : ''}`}>{t}{on ? ' ✓' : ''}</span>)}
      </div>
    </div>
  </section>

  <!-- 4. Кто это говорит -->
  <section class="sec sec--light">
    <div class="sphere sphere--v" style="width:9rem;height:9rem;left:-3rem;bottom:2rem;animation-delay:-3s"></div>
    <div class="shell who">
      <div>
        <h2 class="h2 rv">Я маркетолог, который этим пользуется каждый день</h2>
        <p class="lead rv">
          Шесть лет в онлайне. Дважды платила за обучение нейросетям своими деньгами. И первой
          скажу, где Клод не тянет: он умеет писать как искусственный интеллект, души там нет. Мозг
          включаете вы.
        </p>
        <p class="lead rv" style="margin-top:1rem">
          Под каждую свою задачу у меня в Клоде собран отдельный агент. Такую же систему ставлю
          клиенту. Часть работы делают агенты, поэтому это стоит меньше, чем команда из людей, и
          продолжает работать после того, как я ухожу.
        </p>
      </div>
      <div class="who__side">
        <div class="paper paper--tilt rv" style="background:#0b0b0c;color:#f4f4f2;border-color:#0b0b0c">
          <p class="kicker" style="color:var(--acc)">промпт · черновик 4</p>
          <p class="prompt" style="color:#f4f4f2">
            <s>напиши пост про клиентов</s><br />
            ты пишешь за меня. вот мой голос:<br />
            — короткие фразы, самоирония<br />
            — никаких «в современном мире»<br />
            — в конце вопрос к читателю
          </p>
        </div>
        <div class="short rv">
          <img src="/img/liza-who.webp" alt="Лиза Ким" width="640" height="800" loading="lazy" />
          <div>
            <p class="kicker">коротко</p>
            <p>Лиза Ким, маркетолог, Ростов. Работаю с теми, кто продаёт свои знания и услуги. Клод под маркетинг, чат GPT под остальные ниши.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Статьи -->
  <section class="sec">
    <div class="shell">
      <div class="head-row rv">
        <h2 class="h2 h2--sm">Тут лежит то, чем пользуюсь сама</h2>
        <a class="more" href="/blog/">Все статьи →</a>
      </div>
      {articles.length > 0 && (
        <div class="feed">
          {articles.map((entry) => (
            <ArticleCard
              href={`/blog/${entry.id}/`}
              title={entry.data.title}
              lead={entry.data.lead}
              date={entry.data.date}
              topic={entry.data.topic}
              minutes={readingTime(entry.body ?? '')}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 6. Вопросы -->
  <section class="sec sec--deep">
    <div class="shell">
      <h2 class="h2 silver rv">Что спрашивают до того, как написать</h2>
      <div class="faq">
        {faq.map((item, i) => (
          <details class="q rv" open={i === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Финал -->
  <section class="final">
    <div class="glow" style="left:50%;top:0;margin-left:-24rem;width:48rem;height:32rem"></div>
    <div class="sphere sphere--v" style="width:11rem;height:11rem;right:8%;top:14%"></div>
    <div class="shell" style="position:relative">
      <h2 class="giant silver rv">Дальше<br />в Телеграме</h2>
      <p class="lead rv">
        Там разборы подробнее, промпты, которые можно скопировать одним тапом, и мои цифры,
        включая недели, где ничего не выросло.
      </p>
      <div class="actions rv">
        <a class="btn" href={site.links.telegram}>Подписаться на канал</a>
        <a class="btn btn--ghost" href="/blog/">Сначала почитать</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .compare {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    margin-top: 2rem;
    max-width: 56rem;
  }

  .compare .prompt { margin-top: 0.9rem; }

  .out {
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--card-mute);
  }

  .paper:not(.paper--light) .out { color: var(--text); }
  .out--dead { color: #7c7e83; }

  .thesis {
    margin-top: 2.5rem;
    max-width: 44rem;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.35;
    color: var(--card-ink);
  }

  .big {
    margin-top: 2rem;
    max-width: 30ch;
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.6rem);
    color: var(--card-ink);
  }

  .paths {
    display: grid;
    gap: 2.5rem 3rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 56rem) {
    .paths { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .path__title {
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .path__title span {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .step {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.6rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .step .num { font-size: 0.75rem; color: var(--acc); padding-top: 0.35rem; }
  .step h4 { margin: 0; font-family: var(--display); font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; color: var(--ink); }
  .step p { margin-top: 0.4rem; font-size: 0.95rem; color: var(--text); }

  .step--hot {
    margin: 0.5rem -1rem;
    padding: 1.25rem 1rem;
    border-radius: 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--acc);
    box-shadow: 0 0 60px -20px var(--acc-glow);
  }

  .more {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--acc);
    border-bottom: 1px solid transparent;
  }

  .more:hover { border-bottom-color: var(--acc); }

  .note { max-width: 32ch; font-size: 0.9rem; color: var(--ink-mute); }

  .who {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    position: relative;
  }

  @media (min-width: 56rem) {
    .who { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  }

  .who__side { display: grid; gap: 1.25rem; }

  .short {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    align-items: center;
    background: var(--card);
    border-radius: 1.1rem;
    padding: 1rem;
    box-shadow: 0 24px 50px -30px rgba(0, 0, 0, 0.5);
  }

  .short img { border-radius: 0.7rem; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .short p:last-child { margin-top: 0.4rem; font-size: 0.95rem; color: var(--card-ink); }

  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .feed {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    margin-top: 2rem;
  }

  .final {
    position: relative;
    overflow: hidden;
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(2rem, 4vw, 3rem);
  }
</style>
