---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Статьи получают более узкую колонку под чтение */
  variant?: 'default' | 'reading';
}

const {
  title,
  description = site.description,
  variant = 'default',
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="style" href="/fonts/fonts.css" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%232b2b2b'/><text x='16' y='23' font-family='Georgia,serif' font-style='italic' font-size='20' fill='%23cf6a4c' text-anchor='middle'>л</text></svg>"
    />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">К содержимому</a>
    <Header />
    <main id="main" class={variant === 'reading' ? 'reading' : ''}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    padding: 0.75em 1.2em;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-weight: 600;
  }

  .skip:focus {
    left: 0;
  }

  main {
    display: block;
  }
</style>
