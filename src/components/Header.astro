---
/* Шапка для всех страниц, кроме тех, где первый экран несёт свою навигацию */
import { site, nav } from '../site';

const path = Astro.url.pathname;
---

<header class="masthead">
  <div class="shell inner">
    <a class="wordmark" href="/">{site.name}</a>

    <nav aria-label="Разделы сайта">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.links.telegram} rel="me noopener" target="_blank">Телеграм</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .masthead { border-bottom: 1px solid var(--rule); }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
  }

  nav a {
    font-size: 0.9375rem;
    color: var(--ink-mute);
    padding-block: 0.35em;
    border-bottom: 1.5px solid transparent;
  }

  nav a:hover { color: var(--ink); }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--acc);
  }

  @media (max-width: 32rem) {
    .inner { justify-content: center; padding-block: 1rem; gap: 0.75rem; }
  }
</style>
