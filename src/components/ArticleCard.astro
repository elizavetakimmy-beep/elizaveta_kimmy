---
import { formatDate } from '../site';

interface Props {
  href: string;
  title: string;
  lead: string;
  date: Date;
  topic: string;
  minutes: string;
}

const { href, title, lead, date, topic, minutes } = Astro.props;
---

<article class="card">
  <div class="card__meta">
    <span class="sticker">{topic}</span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="dot" aria-hidden="true">·</span>
    <span>{minutes}</span>
  </div>

  <h3 class="card__title">
    <a href={href}>{title}</a>
  </h3>

  <p class="card__lead">{lead}</p>
  <a class="card__more" href={href} aria-hidden="true" tabindex="-1">Читать →</a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 1.1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover { border-color: var(--acc); transform: translateY(-2px); }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-mute);
  }

  .dot { color: var(--rule-strong); }

  .card__title {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    letter-spacing: -0.02em;
  }

  .card__title a { color: var(--ink); }

  .card__lead {
    font-size: 0.95rem;
    color: var(--text);
    flex: 1;
  }

  .card__more {
    font-size: 0.9rem;
    color: var(--acc);
  }
</style>
