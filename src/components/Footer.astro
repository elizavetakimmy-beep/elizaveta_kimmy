---
import { site, nav, legalDocs } from '../site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell">
    <div class="row row--top">
      <a class="wordmark" href="/">{site.name}</a>
      <nav aria-label="Разделы сайта">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={site.links.instagram} rel="me noopener" target="_blank">Инстаграм</a></li>
          <li><a href={site.links.telegram} rel="me noopener" target="_blank">Телеграм</a></li>
        </ul>
      </nav>
    </div>

    <ul class="docs">
      {legalDocs.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
    </ul>

    <div class="row row--legal">
      <p>
        Самозанятая {site.legal.fio} · ИНН {site.legal.inn} · налог на профессиональный доход<br />
        <a href={site.legal.phoneHref}>{site.legal.phone}</a> · <a href={`mailto:${site.links.email}`}>{site.links.email}</a>
      </p>
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--rule);
    padding-block: 1.75rem 2.5rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-mute);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }

  .row--top {
    font-family: var(--sans);
    font-size: 0.95rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .row--top a { color: var(--text); }
  .row--top a:hover { color: var(--ink); }

  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink) !important;
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .docs {
    display: flex;
    gap: 0.75rem 1.75rem;
    flex-wrap: wrap;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .docs a {
    color: var(--text);
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 0.1em;
  }

  .docs a:hover { color: var(--ink); border-color: var(--acc); }

  .row--legal {
    align-items: flex-start;
    padding-top: 1rem;
    line-height: 1.7;
  }

  .row--legal a { color: inherit; }
  .row--legal a:hover { color: var(--ink); }
</style>
